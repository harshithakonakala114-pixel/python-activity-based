"""Rank scholarship applicants and award scholarships to the top two."""

applicants = [
    ["S01", 88, 82, 90, 92, 240000],
    ["S02", 88, 79, 85, 95, 210000],
    ["S03", 72, 80, 81, 90, 180000],
]

SCHOLARSHIPS = 2
eligible = []
rejected = []

for row in applicants:
    student, aggregate, math, english, attendance, income = row
    reasons = []
    if aggregate < 75:
        reasons.append("aggregate below 75")
    if math < 50:
        reasons.append("math below 50")
    if english < 50:
        reasons.append("English below 50")
    if attendance < 75:
        reasons.append("attendance below 75")
    if income > 300000:
        reasons.append("family income above 300000")

    if reasons:
        rejected.append((student, reasons))
    else:
        eligible.append((aggregate, income, attendance, math + english, student))

# Rank by aggregate descending, income ascending, attendance descending,
# subject total descending, and student ID alphabetically.
eligible.sort(key=lambda item: (-item[0], item[1], -item[2], -item[3], item[4]))

for rank, (_, _, _, _, student) in enumerate(eligible, start=1):
    status = "AWARDED" if rank <= SCHOLARSHIPS else "WAITLIST"
    print(f"Rank {rank} {student} {status}")

